# ── Azure OpenAI ───────────────────────────────────────────────
# 在 Azure Portal > Azure OpenAI > Keys and Endpoint 取得
AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o
AZURE_OPENAI_API_VERSION=2024-02-01

# ── Azure AI Content Safety（Phase 5a — Prompt Shields）────────
# 在 Azure Portal > AI Content Safety > Keys and Endpoint 取得
# 未設定時 Semantic Gateway 會靜默跳過（開發環境友好）
AZURE_CONTENT_SAFETY_ENDPOINT=https://your-content-safety.cognitiveservices.azure.com
AZURE_CONTENT_SAFETY_KEY=your_content_safety_key_here

# Fail-open（true）= API 失敗時放行；false = API 失敗時阻擋
# PoC 建議 true，生產環境視需求調整
SEMANTIC_GATEWAY_FAIL_OPEN=true

# ── App Settings ───────────────────────────────────────────────
# 生產環境請設為 false
DEBUG=true

# ── Database（Phase 0 — 持久化 Session/Profile/Rule/Persona 等）──
# 本地開發：docker compose up -d（見 docker-compose.yml，對外 port 為 5433）
# 生產環境（Vercel）：建議用 Supabase / Neon 的 Transaction Pooler 連線字串
#   - Supabase：Dashboard 右上角 Connect → Transaction pooler（port 6543）
#   - 記得把 postgresql:// 開頭改成 postgresql+asyncpg://
#   - 不需要保留 ?pgbouncer=true 參數，程式碼會自動處理相容性
#   - 若連線字串裡有 [YOUR-PASSWORD] 記得換成實際密碼（含方括號都要拿掉）
# 格式：postgresql+asyncpg://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/peacemind

# 只在「本機執行 alembic upgrade head」時暫時使用：Supabase 的 Session Pooler
# （port 5432，非 transaction 模式，才支援 migration 需要的 prepared statements）。
# 執行 migration 時，把上面的 DATABASE_URL 暫時換成這個值即可，
# Vercel 正式環境的 DATABASE_URL 仍然使用 Transaction Pooler（6543）。
# DATABASE_URL（跑 migration 時暫用）=postgresql+asyncpg://postgres.xxxx:密碼@aws-0-xxxxx.pooler.supabase.com:5432/postgres
